@model LynxExpeditions.Models.HomeViewModel
@{
    ViewData["Title"] = "Lynx Expeditions — Discover Macedonia";
}

<!-- Cookie Banner -->
<div class="cookie-banner" id="cookieBanner">
    <div class="cookie-text">
        🐾 We use cookies to remember your saved tours and pre-fill your booking details for a smoother experience.
        <a href="#">Learn more</a>
    </div>
    <div class="cookie-actions">
        <button class="cookie-decline" onclick="declineCookies()">Decline</button>
        <button class="cookie-accept" onclick="acceptCookies()">Accept cookies</button>
    </div>
</div>

<!-- Welcome Back Banner -->
<div class="welcome-back" id="welcomeBack">
    Welcome back! You were looking at <a href="#tours" id="welcomeBackTour">our tours</a> last time. 🐾
</div>

<!-- Saved Tours Button -->
<button class="saved-toggle-btn" id="savedToggleBtn" onclick="toggleSavedSidebar()">
    ♡ <span id="savedCount">0</span> saved
</button>

<!-- Saved Tours Sidebar -->
<div class="saved-sidebar" id="savedSidebar">
    <h4>Saved tours</h4>
    <div id="savedSidebarList"></div>
</div>

<!-- Navigation -->
<nav>
    <a href="#" class="nav-logo">
        <div class="nav-logo-icon">🐾</div>
        <div class="nav-logo-text">Lynx <span>Expeditions</span></div>
    </a>
    <ul class="nav-links">
        <li><a href="#tours">Tours</a></li>
        <li><a href="#destinations">Destinations</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#blog">Blog</a></li>
        <li><a href="#booking">Book</a></li>
    </ul>
    <div class="nav-actions">
        <button class="lang-toggle" onclick="toggleLang()" id="langBtn">МК</button>
        <a href="#booking" class="nav-cta">Book a tour</a>
    </div>
    <button class="hamburger" onclick="toggleMobileMenu()">
        <span></span><span></span><span></span>
    </button>
</nav>

<!-- Hero -->
<section class="hero" id="home">
    <div class="hero-bg"></div>
    <svg class="hero-mountains" viewBox="0 0 1440 500" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 500 L0 280 L120 220 L200 260 L300 160 L420 240 L520 130 L620 200 L700 100 L800 180 L900 80 L1000 160 L1100 120 L1200 200 L1300 140 L1440 220 L1440 500 Z" fill="rgba(26,43,31,0.7)"/>
        <path d="M0 500 L0 350 L180 300 L280 330 L380 270 L480 310 L580 250 L680 290 L780 230 L880 280 L980 240 L1100 290 L1200 260 L1320 300 L1440 270 L1440 500 Z" fill="rgba(15,26,18,0.85)"/>
        <path d="M0 500 L0 420 L200 380 L350 400 L500 360 L650 390 L800 350 L950 380 L1100 360 L1250 390 L1440 370 L1440 500 Z" fill="#0f1a12"/>
    </svg>
    <div class="hero-content">
        <div class="hero-eyebrow">Macedonia's premier expedition company</div>
        <h1 class="hero-title">Where the <em>wild</em> mountains call your name</h1>
        <p class="hero-sub">Discover ancient lakes, hidden gorges, and centuries-old monasteries. We take you off the map — into the real Macedonia.</p>
        <div class="hero-btns">
            <a href="#tours" class="btn-primary">Explore tours</a>
            <a href="#about" class="btn-outline">Our story</a>
        </div>
    </div>
    <div class="hero-stats">
        <div class="hero-stat">
            <div class="hero-stat-num">24+</div>
            <div class="hero-stat-label">Curated routes</div>
        </div>
        <div class="hero-stat">
            <div class="hero-stat-num">1,200+</div>
            <div class="hero-stat-label">Adventurers guided</div>
        </div>
        <div class="hero-stat">
            <div class="hero-stat-num">8</div>
            <div class="hero-stat-label">Regions covered</div>
        </div>
    </div>
</section>

<!-- Tours -->
<section class="tours-section" id="tours">
    <div class="tours-header">
        <div>
            <div class="section-eyebrow">Our expeditions</div>
            <h2 class="section-title">Choose your adventure</h2>
        </div>
        <p class="section-sub" style="margin-bottom:0">Handcrafted journeys for every pace — from easy cultural walks to multi-day wilderness treks.</p>
    </div>
    <div class="tours-filter">
        <button class="filter-btn active" onclick="filterTours('all', this)">All tours</button>
        <button class="filter-btn" onclick="filterTours('nature', this)">Nature</button>
        <button class="filter-btn" onclick="filterTours('cultural', this)">Cultural</button>
        <button class="filter-btn" onclick="filterTours('adventure', this)">Adventure</button>
        <button class="filter-btn" onclick="filterTours('winter', this)">Winter</button>
    </div>
    <!-- Populated client-side by renderTours() in js/site.js, from the Tour data
         served by HomeController (see window.__LYNX_DATA__ below). -->
    <div class="tours-grid" id="toursGrid"></div>
</section>

<!-- Destinations -->
<section class="destinations-section" id="destinations">
    <div class="section-eyebrow">Where we go</div>
    <h2 class="section-title">Explore Macedonia's wonders</h2>
    <p class="section-sub">From the shores of Ohrid Lake to the peaks of Mavrovo — every corner holds a story.</p>
    <div class="destinations-grid">
        <div class="map-container">
            <svg class="map-svg" viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
                <rect width="400" height="320" fill="#1A2B1F"/>
                <path d="M60 80 L80 60 L120 55 L160 70 L200 65 L250 75 L300 70 L340 85 L350 110 L340 140 L320 160 L300 180 L280 210 L250 230 L220 240 L190 250 L160 245 L130 240 L100 230 L80 210 L60 190 L50 160 L45 130 L55 100 Z" fill="#243628" stroke="rgba(255,255,255,0.12)" stroke-width="1.5"/>
                <!-- Rivers -->
                <path d="M100 140 Q160 160 220 150 Q260 145 300 160" stroke="rgba(100,180,200,0.4)" stroke-width="1.5" fill="none"/>
                <path d="M180 80 Q190 130 200 160 Q210 190 215 230" stroke="rgba(100,180,200,0.3)" stroke-width="1" fill="none"/>
                <!-- Pins -->
                <g class="map-pin" onclick="selectDest(0)" id="pin0">
                    <circle cx="155" cy="215" r="18" fill="rgba(201,146,58,0.15)" stroke="rgba(201,146,58,0.4)" stroke-width="1"/>
                    <circle cx="155" cy="215" r="7" fill="#C9923A"/>
                    <text x="155" y="238" text-anchor="middle" fill="rgba(255,255,255,0.8)" font-size="9" font-family="Inter">Ohrid</text>
                </g>
                <g class="map-pin" onclick="selectDest(1)" id="pin1">
                    <circle cx="220" cy="155" r="18" fill="rgba(201,146,58,0.08)" stroke="rgba(201,146,58,0.2)" stroke-width="1"/>
                    <circle cx="220" cy="155" r="5" fill="#8FA394"/>
                    <text x="220" y="178" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-size="9" font-family="Inter">Skopje</text>
                </g>
                <g class="map-pin" onclick="selectDest(2)" id="pin2">
                    <circle cx="135" cy="130" r="18" fill="rgba(201,146,58,0.08)" stroke="rgba(201,146,58,0.2)" stroke-width="1"/>
                    <circle cx="135" cy="130" r="5" fill="#8FA394"/>
                    <text x="135" y="153" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-size="9" font-family="Inter">Mavrovo</text>
                </g>
                <g class="map-pin" onclick="selectDest(3)" id="pin3">
                    <circle cx="258" cy="178" r="18" fill="rgba(201,146,58,0.08)" stroke="rgba(201,146,58,0.2)" stroke-width="1"/>
                    <circle cx="258" cy="178" r="5" fill="#8FA394"/>
                    <text x="258" y="201" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-size="9" font-family="Inter">Stobi</text>
                </g>
                <g class="map-pin" onclick="selectDest(4)" id="pin4">
                    <circle cx="185" cy="95" r="18" fill="rgba(201,146,58,0.08)" stroke="rgba(201,146,58,0.2)" stroke-width="1"/>
                    <circle cx="185" cy="95" r="5" fill="#8FA394"/>
                    <text x="185" y="118" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-size="9" font-family="Inter">Tetovo</text>
                </g>
                <g class="map-pin" onclick="selectDest(5)" id="pin5">
                    <circle cx="200" cy="230" r="18" fill="rgba(201,146,58,0.08)" stroke="rgba(201,146,58,0.2)" stroke-width="1"/>
                    <circle cx="200" cy="230" r="5" fill="#8FA394"/>
                    <text x="200" y="253" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-size="9" font-family="Inter">Bitola</text>
                </g>
                <text id="titleName" x="200" y="20" text-anchor="middle" fill="rgba(255,255,255,0.3)" font-size="10" font-family="Inter" font-weight="600" letter-spacing="2">North Macedonia</text>
            </svg>
        </div>
        <!-- Populated client-side by renderDestinations() in js/site.js -->
        <div class="destinations-list" id="destList"></div>
    </div>
</section>

<!-- About -->
<section class="about-section" id="about">
    <div class="about-grid">
        <div class="about-text">
            <div class="section-eyebrow">Who we are</div>
            <h2 class="section-title">Born from the mountains, guided by passion</h2>
            <p class="section-sub">Lynx Expeditions was founded in 2017 by a group of local guides who wanted to share Macedonia's hidden treasures with the world. Named after the critically endangered Balkan lynx — Macedonia's rarest and most elusive resident — we believe in travel that protects what it celebrates.</p>
            <div class="about-features">
                <div class="about-feature">
                    <div class="about-feature-icon">🐾</div>
                    <div class="about-feature-text">
                        <h4>Local expertise</h4>
                        <p>Every guide is a local — born and raised in the regions they lead.</p>
                    </div>
                </div>
                <div class="about-feature">
                    <div class="about-feature-icon">🌿</div>
                    <div class="about-feature-text">
                        <h4>Sustainable travel</h4>
                        <p>5% of every booking goes to Macedonian wildlife conservation.</p>
                    </div>
                </div>
                <div class="about-feature">
                    <div class="about-feature-icon">🏔️</div>
                    <div class="about-feature-text">
                        <h4>Small groups only</h4>
                        <p>Maximum 10 people per tour. More nature, fewer crowds.</p>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <h3 style="font-family:'Playfair Display',serif;color:var(--white);font-size:1.3rem;margin-bottom:1.5rem;font-weight:600" id="meet">Meet the guides</h3>
            <!-- These four cards are rendered server-side from Model.GuidesEn
                 (LynxExpeditions.Data.GuideData / Models.Guide). The ids below
                 (firstGuide..fourthGuide) are still relied on by toggleLang()
                 in js/site.js to swap the text when switching to Macedonian. -->
            <div class="team-grid">
                @{
                    var guideCardIds = new[] { "firstGuide", "secondGuide", "thirdGuide", "fourthGuide" };
                }
                @for (var i = 0; i < Model.GuidesEn.Count && i < guideCardIds.Length; i++)
                {
                    var guide = Model.GuidesEn[i];
                    <div class="team-card" id="@guideCardIds[i]">
                        <div class="team-avatar">@guide.Avatar</div>
                        <div class="team-name">@guide.Name</div>
                        <div class="team-role">@guide.Role</div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="testimonials-section" id="testimonials">
    <div class="section-eyebrow">What travelers say</div>
    <h2 class="section-title">Real stories, real adventures</h2>
    <p class="section-sub" style="margin-bottom:3rem">Over 1,200 guests have explored Macedonia with us. Here are some of their stories.</p>
    <div class="testimonials-grid">
        <div class="testimonial-card">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-text">"The Matka Canyon boat tour was breathtaking. Stefan knew every cave, every bird call. I've never felt so far from the tourist trail while being completely safe."</p>
            <div class="testimonial-author">
                <div class="testimonial-avatar">JM</div>
                <div>
                    <div class="testimonial-name">James Mitchell</div>
                    <div class="testimonial-location">London, UK · Matka Canyon Tour</div>
                </div>
            </div>
        </div>
        <div class="testimonial-card">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-text">"Ohrid is extraordinary — but having a guide who grew up there made the difference. Ana took us to a 10th-century fresco that no guidebook mentions."</p>
            <div class="testimonial-author">
                <div class="testimonial-avatar">SB</div>
                <div>
                    <div class="testimonial-name">Sophie Beaumont</div>
                    <div class="testimonial-location">Paris, France · Ohrid Cultural Journey</div>
                </div>
            </div>
        </div>
        <div class="testimonial-card">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-text">"I was skeptical about a winter ski tour in Macedonia, but Mavrovo was stunning and almost empty. Bojan found us fresh powder every single day."</p>
            <div class="testimonial-author">
                <div class="testimonial-avatar">MK</div>
                <div>
                    <div class="testimonial-name">Mikael Karlsson</div>
                    <div class="testimonial-location">Stockholm, Sweden · Mavrovo Winter Week</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Blog -->
<section class="blog-section" id="blog">
    <div class="section-eyebrow">Travel journal</div>
    <h2 class="section-title">Stories from the trail</h2>
    <p class="section-sub" style="margin-bottom:3rem">Guides, tips, seasonal updates, and dispatches from the Macedonian wild.</p>
    <div class="blog-grid">
        <div class="blog-card">
            <div class="blog-img">🌅</div>
            <div class="blog-body">
                <div class="blog-category">Seasonal guide</div>
                <h3 class="blog-title">The best time to visit Ohrid Lake — month by month</h3>
                <div class="blog-meta">Elena Stojanovska · 8 min read · April 2025</div>
            </div>
        </div>
        <div class="blog-card">
            <div class="blog-img">🦅</div>
            <div class="blog-body">
                <div class="blog-category">Wildlife</div>
                <h3 class="blog-title">Spotting the Balkan lynx: what we know, what we hope</h3>
                <div class="blog-meta">Elena Stojanovska · 6 min read · March 2025</div>
            </div>
        </div>
        <div class="blog-card">
            <div class="blog-img">⛪</div>
            <div class="blog-body">
                <div class="blog-category">Culture</div>
                <h3 class="blog-title">Byzantine frescoes of Ohrid: a visual guide for beginners</h3>
                <div class="blog-meta">Ana Nikolovska · 10 min read · February 2025</div>
            </div>
        </div>
    </div>
</section>

<!-- Booking -->
<section class="booking-section" id="booking">
    <div class="booking-wrapper">
        <div class="booking-info">
            <div class="section-eyebrow">Reserve your place</div>
            <h2 class="section-title">Ready to go?</h2>
            <p class="section-sub">Fill in your details and we'll confirm availability within 24 hours. All tours include a local guide, transport, and meals where noted.</p>
            <div class="booking-steps">
                <div class="booking-step">
                    <div class="step-num">1</div>
                    <div class="step-text">
                        <h4>Submit your request</h4>
                        <p>Tell us which tour and your preferred dates.</p>
                    </div>
                </div>
                <div class="booking-step">
                    <div class="step-num">2</div>
                    <div class="step-text">
                        <h4>We confirm availability</h4>
                        <p>Expect a reply within 24 hours with pricing and details.</p>
                    </div>
                </div>
                <div class="booking-step">
                    <div class="step-num">3</div>
                    <div class="step-text">
                        <h4>Secure your spot</h4>
                        <p>A 30% deposit holds your place. Full payment 14 days before departure.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="booking-form">
            <div class="saved-tour-notice" id="savedTourNotice"></div>
            <div id="bookingFormInner">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">First name</label>
                        <input type="text" class="form-input" id="firstName" placeholder="Dime">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Last name</label>
                        <input type="text" class="form-input" id="lastName" placeholder="Dimovski">
                    </div>
                    <div class="form-group form-full">
                        <label class="form-label">Email address</label>
                        <input type="email" class="form-input" id="email" placeholder="dime@example.com">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone number</label>
                        <input type="tel" class="form-input" id="phone" placeholder="+389 07 000 111">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Number of people</label>
                        <select class="form-input" id="groupSize">
                            <option value="">Select...</option>
                            <option>1</option><option>2</option><option>3</option>
                            <option>4</option><option>5-8</option><option>9+</option>
                        </select>
                    </div>
                    <div class="form-group form-full">
                        <label class="form-label">Select tour</label>
                        <select class="form-input" id="tourSelect">
                            <option value="">Choose a tour...</option>
                            @foreach (var tour in Model.ToursEn)
                            {
                                <option>@tour.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Preferred start date</label>
                        <input type="date" class="form-input" id="startDate">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Flexibility</label>
                        <select class="form-input" id="flexibility">
                            <option value="">Select...</option>
                            <option>Exact date only</option>
                            <option>±3 days</option>
                            <option>±1 week</option>
                            <option>Flexible</option>
                        </select>
                    </div>
                    <div class="form-group form-full">
                        <label class="form-label">Special requests or questions</label>
                        <textarea class="form-input" id="message" rows="3" placeholder="Dietary needs, accessibility requirements, questions about the tour..."></textarea>
                    </div>
                </div>
                <button class="form-submit" onclick="submitBooking()">Send booking request →</button>
                <p class="form-privacy">🔒 Your information is safe. We never share your data with third parties.</p>
            </div>
            <div class="form-success" id="formSuccess">
                <div style="font-size:3rem;margin-bottom:1rem">✅</div>
                <h3>Booking request sent!</h3>
                <p>We'll get back to you at your email address within 24 hours to confirm your adventure.</p>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer>
    <div class="footer-grid">
        <div class="footer-brand">
            <a href="#" class="nav-logo" style="display:inline-flex;margin-bottom:1rem">
                <div class="nav-logo-icon">🐾</div>
                <div class="nav-logo-text">Lynx <span>Expeditions</span></div>
            </a>
            <p>Guiding adventurers through the wild beauty of North Macedonia since 2017. Small groups. Big experiences.</p>
            <div class="footer-contact">
                <a href="mailto:hello@lynxexpeditions.mk">📧 hello@lynxexpeditions.mk</a>
                <a href="tel:+38972000000">📞 +389 72 000 000</a>
                <a href="#">📍 Skopje, North Macedonia</a>
            </div>
        </div>
        <div class="footer-col">
            <h5>Tours</h5>
            <ul>
                <li><a href="#tours">Nature tours</a></li>
                <li><a href="#tours">Cultural walks</a></li>
                <li><a href="#tours">Adventure treks</a></li>
                <li><a href="#tours">Winter expeditions</a></li>
                <li><a href="#tours">Custom tours</a></li>
            </ul>
        </div>
        <div class="footer-col">
            <h5>Destinations</h5>
            <ul>
                <li><a href="#destinations">Ohrid</a></li>
                <li><a href="#destinations">Matka Canyon</a></li>
                <li><a href="#destinations">Mavrovo</a></li>
                <li><a href="#destinations">Stobi</a></li>
                <li><a href="#destinations">Prespa Lake</a></li>
            </ul>
        </div>
        <div class="footer-col">
            <h5>Company</h5>
            <ul>
                <li><a href="#about">About us</a></li>
                <li><a href="#blog">Travel blog</a></li>
                <li><a href="#booking">Book a tour</a></li>
                <li><a href="#">Privacy policy</a></li>
                <li><a href="#">Cookie settings</a></li>
            </ul>
        </div>
    </div>
    <div class="footer-bottom">
        <span>© 2025 Lynx Expeditions. All rights reserved.</span>
        <span>Named after North Macedonia's rarest wild cat 🐾</span>
    </div>
</footer>

@section Scripts {
    <script>
        // Tour / tour-detail / destination / guide data, served by
        // Controllers/HomeController.cs from the C# models in Data/ and Models/.
        // js/site.js reads this instead of the hardcoded arrays the original
        // static page used, while all rendering/interactivity logic in that
        // file is otherwise unchanged.
        window.__LYNX_DATA__ = {
            toursEn: @Html.Raw(Model.ToursEnJson),
            toursMk: @Html.Raw(Model.ToursMkJson),
            tourDetailsEn: @Html.Raw(Model.TourDetailsEnJson),
            tourDetailsMk: @Html.Raw(Model.TourDetailsMkJson),
            destinationsEn: @Html.Raw(Model.DestinationsEnJson),
            destinationsMk: @Html.Raw(Model.DestinationsMkJson),
            guidesEn: @Html.Raw(Model.GuidesEnJson),
            guidesMk: @Html.Raw(Model.GuidesMkJson)
        };
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
}
